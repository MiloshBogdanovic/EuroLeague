# RapidAPI OddsPapi (https://rapidapi.com/odds-papi-odds-papi-default/api/odds-api1)
# Same as:
#   curl --request GET \
#     --url https://odds-api1.p.rapidapi.com/sports \
#     --header 'x-rapidapi-host: odds-api1.p.rapidapi.com' \
#     --header 'x-rapidapi-key: YOUR_KEY'

ODDSPAPI_API_KEY=your_rapidapi_key_here
ODDSPAPI_BASE_URL=https://odds-api1.p.rapidapi.com
ODDSPAPI_RAPIDAPI_HOST=odds-api1.p.rapidapi.com

# Bet365 backup API (same RapidAPI key; separate host)
# https://rapidapi.com/odds-papi-odds-papi-default/api/bet36528
BET365_RAPIDAPI_HOST=bet36528.p.rapidapi.com
# BET365_RAPIDAPI_BASE_URL=https://bet36528.p.rapidapi.com

# Optional: force Market cut to use data/bet365_points_board.json
# EURO_PREFER_BET365_BOARD=1

# Do not wrap the key in quotes.
